{
  "name": "de-waker-goirle",
  "private": true,
  "version": "1.0.0",
  "description": "Website voor bewoners van appartementencomplex De Waker in Goirle",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "dev:login": "npm run build && node --env-file-if-exists=.env.local scripts/dev.js",
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "bewoner": "node --env-file-if-exists=.env.local scripts/resident.js"
  },
  "dependencies": {
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=22"
  }
}
